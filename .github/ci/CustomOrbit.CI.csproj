<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>CustomOrbit</AssemblyName>
    <RootNamespace>CustomOrbit</RootNamespace>
    <Version>1.0.0</Version>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>CS0649;CS0169;CS0414</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Output to repo root so workflow can find it easily -->
    <OutputPath>..\..\bin\Release\</OutputPath>
  </PropertyGroup>

  <!-- Compile the same source files as the original csproj -->
  <ItemGroup>
    <Compile Include="..\..\CustomOrbitPlugin.cs" Link="CustomOrbitPlugin.cs" />
    <Compile Include="..\..\MonoBehaviours\CustomOrbitComponent.cs" Link="MonoBehaviours\CustomOrbitComponent.cs" />
    <Compile Include="..\..\Properties\AssemblyInfo.cs" Link="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <!-- BepInEx + Harmony + Unity from NuGet (open-source) -->
  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="HarmonyX" Version="2.10.2" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.9" />
  </ItemGroup>

  <!-- Game-specific stubs (minimal signatures, no proprietary code) -->
  <ItemGroup>
    <ProjectReference Include="stubs\Assembly-CSharp\Assembly-CSharp.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
</Project>
